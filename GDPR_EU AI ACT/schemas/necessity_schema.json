{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["project_name", "justifications"],
  "additionalProperties": false,
  "properties": {
    "project_name": {
      "type": "string",
      "description": "项目名称"
    },
    "justifications": {
      "type": "array",
      "description": "每个风险点的必要性论证列表",
      "items": {
        "type": "object",
        "required": ["risk_id", "is_necessary", "reasoning", "alternatives_considered"],
        "additionalProperties": false,
        "properties": {
          "risk_id": {
            "type": "string",
            "pattern": "^R[0-9]{3}$",
            "description": "对应的风险ID，必须与风险识别模块输出的ID一致"
          },
          "is_necessary": {
            "type": "boolean",
            "description": "该处理活动是否必要"
          },
          "reasoning": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "description": "必要性的详细论证理由"
          },
          "alternatives_considered": {
            "type": "array",
            "description": "考虑过的替代方案",
            "items": {"type": "string"},
            "minItems": 1
          },
          "proportionality": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "description": "相称性评估"
          }
        }
      }
    }
  }
}