{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["project_name", "project_description", "legal_basis", "risk_points"],
  "additionalProperties": false,
  "properties": {
    "project_name": {"type": "string", "minLength": 1},
    "project_description": {"type": "string", "minLength": 10, "maxLength": 500},
    "legal_basis": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "risk_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "risk_domain", "risk_description", "risk_cause", "law_articles", "severity", "confidence"],
        "additionalProperties": false,
        "properties": {
          "risk_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
          "risk_domain": {
            "type": "string",
            "enum": ["data", "algorithm", "user_rights", "operation_governance"]
          },
          "risk_description": {"type": "string", "minLength": 5, "maxLength": 500},
          "risk_cause": {"type": "string", "minLength": 5, "maxLength": 300},
          "law_articles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["law", "article", "description"],
              "additionalProperties": false,
              "properties": {
                "law": {"type": "string"},
                "article": {"type": "string"},
                "description": {"type": "string"}
              }
            },
            "minItems": 1
          },
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "minItems": 1
    }
  }
}
